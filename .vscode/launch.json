// Launch configs for running from the REPO ROOT. Each project also keeps its own
// .vscode/launch.json, which only applies when that project folder is the workspace root.
// The admin dashboard proxies every request to the App API and needs Auth for tokens, so use
// the compound "Admin stack" to bring all three up together.
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Auth (7098)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-auth",
            "program": "${workspaceFolder}/src/Envirotrax.Auth/bin/Debug/net10.0/Envirotrax.Auth.dll",
            "cwd": "${workspaceFolder}/src/Envirotrax.Auth",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": "App API (7095)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-app",
            "program": "${workspaceFolder}/src/Envirotrax.App/Envirotrax.App.Server/bin/Debug/net10.0/Envirotrax.App.Server.dll",
            "cwd": "${workspaceFolder}/src/Envirotrax.App/Envirotrax.App.Server",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": "Admin Dashboard (7029)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-admin",
            "program": "${workspaceFolder}/src/Envirotrax.Admin/Envirotrax.Admin.Server/bin/Debug/net10.0/Envirotrax.Admin.Server.dll",
            "cwd": "${workspaceFolder}/src/Envirotrax.Admin/Envirotrax.Admin.Server",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ],
    "compounds": [
        {
            "name": "Admin stack (Auth + App API + Admin)",
            "configurations": [
                "Auth (7098)",
                "App API (7095)",
                "Admin Dashboard (7029)"
            ],
            "stopAll": true
        }
    ]
}
