@using RazorLight
@using Envirotrax.App.Server.Templates.Emails.Sites
@inherits TemplatePage<RenewalEmailVm>

@{
    Layout = "Templates.Emails._EmailLayout";

    var verifyUrl = $"{ViewBag.BaseUrl}/renewal-opt-in/verify-email?id={Model.VerificationId}&token={System.Uri.EscapeDataString(Model.Token)}";
}

<div>
    <h2 style="margin-top: 0;">Verify Your Email Address</h2>

    <p>
        <strong>@Model.EmailAddress</strong> has been added as a renewal notification recipient for a site registered with Envirotrax.
        Please click the link below to verify your email address. This link is valid for <strong>7 days</strong>.
    </p>

    <p style="margin: 24px 0;">
        <a href="@verifyUrl" target="_blank" style="background: #0d6efd; color: #fff; padding: 12px 24px; text-decoration: none; border-radius: 4px; display: inline-block;">Verify Email Address</a>
    </p>

    <p style="color: #6c757d; font-size: 13px;">
        Or copy and paste this link into your browser:<br />
        <a href="@verifyUrl" target="_blank">@verifyUrl</a>
    </p>

    <p style="color: #6c757d; font-size: 13px; margin-bottom: 0;">
        If you did not expect this email, you can safely ignore it.
    </p>
</div>
