@using System.Linq
@model System.Collections.Generic.IEnumerable<Envirotrax.App.Server.Domain.DataTransferObjects.Backflow.BackflowTestDto>
@{
    Layout = null;

    var reasonLabels = new System.Collections.Generic.Dictionary<int, string>
    {
        [0] = "Annual Test",
        [1] = "New Installation",
        [2] = "Existing Installation",
        [3] = "Replacement",
        [4] = "Repair",
        [5] = "Annual Test After Repairs"
    };
    var resultLabels = new System.Collections.Generic.Dictionary<int, string>
    {
        [0] = "Passed",
        [1] = "Failed",
        [2] = "Passed After Repairs"
    };
    var deviceTypeLabels = new System.Collections.Generic.Dictionary<string, string>
    {
        ["DC"] = "DC - Double Check Valve",
        ["DCD"] = "DCD - Double Check Detector",
        ["DCD2"] = "DCD2 - Double Check Detector Type II",
        ["RP"] = "RP - Reduced Pressure Principle",
        ["RPPD"] = "RPPD - Reduced Pressure Principle Detector",
        ["RPPD2"] = "RPPD2 - Reduced Pressure Principle Detector Type II",
        ["PVB"] = "PVB - Pressure Vacuum Breaker",
        ["SVB"] = "SVB - Spill-Resistant Pressure Vacuum Breaker",
        ["AG"] = "AG - Air Gap"
    };

    // Reading column definitions — mirrors Angular _valveColumns
    var allReadingCols = new (int Index, string Group, string Header, string InitVerb, string? InitVal, (string Label,
string Field)[] InitChecks, string? RepairField, string? RepairDetailsField, string? FinalVerb, string? FinalVal,
(string Label, string Field)[] FinalChecks)[]
    {
        (1, "main", "Check Valve #1", "Held at", "InitCV1HeldPSID", new[] { ("Closed Tight", "InitCV1ClosedTight"),
("Leaked","InitCV1Leaked") }, "RepairCV1", "RepairCV1Details", "Held at", "FinalCV1HeldPSID", new[] { ("Closed Tight","FinalCV1ClosedTight") }),
        (2, "main", "Check Valve #2 ***", "Held at", "InitCV2HeldPSID", new[] { ("Closed Tight",
"InitCV2ClosedTight"),("Leaked", "InitCV2Leaked") }, "RepairCV2", "RepairCV2Details", "Held at", "FinalCV2HeldPSID",
new[] { ("Closed Tight","FinalCV2ClosedTight") }),
        (3, "main", "Relief Valve", "Opened at", "InitRVOpenedPSID", new[] { ("Did not open", "InitRVDidNotOpen") },
"RepairRV","RepairRVDetails", "Opened at", "FinalRVOpenedPSID", System.Array.Empty<(string, string)>()),
        (4, "bypass", "Check Valve #1", "Held at", "InitCV1HeldPSID2", new[] { ("Closed Tight",
"InitCV1ClosedTight2"),("Leaked", "InitCV1Leaked2") }, "RepairCV12", "RepairCV1Details2", "Held at",
"FinalCV1HeldPSID2", new[] { ("Closed Tight", "FinalCV1ClosedTight2") }),
        (5, "bypass", "Check Valve #2 ***", "Held at", "InitCV2HeldPSID2", new[] { ("Closed Tight",
"InitCV2ClosedTight2"),("Leaked", "InitCV2Leaked2") }, "RepairCV22", "RepairCV2Details2", "Held at", null, new[] {
("Closed Tight","FinalCV2ClosedTight2") }),
        (6, "bypass", "Relief Valve", "Opened at", "InitRVOpenedPSID2", new[] { ("Did not open", "InitRVDidNotOpen2")
},"RepairRV2", "RepairRVDetails2", "Opened at", "FinalRVOpenedPSID2", System.Array.Empty<(string, string)>()),
        (7, "bypass", "Bypass Check", "Held at", "InitBCHeldPSID", new[] { ("Closed Tight", "InitBCClosedTight"),
("Leaked","InitBCLeaked") }, "RepairBC", "RepairBCDetails", "Held at", "FinalBCHeldPSID", new[] { ("Closed Tight","FinalBCClosedTight") }),
        (8, "main", "Air Inlet", "Opened at", "InitPvbAirInletOpenedPSID", new[] { ("Did not open","InitPvbAirInletDidNotOpen"),
("Fully opened", "InitPvbAirInletFullyOpened") }, null, null, "Opened at","FinalPvbAirInletOpenedPSID", new[] { ("Fully opened", "FinalPvbAirInletFullyOpened") }),
        (9, "main", "Check Valve", "Held at", "InitPvbCVHeldPSID", new[] { ("Leaked", "InitPvbCVLeaked") }, null, null, "Held at", "FinalPvbCVHeldPSID", System.Array.Empty<(string, string)>()),
    };
    var deviceColMap = new System.Collections.Generic.Dictionary<string, int[]>
    {
        ["DC"] = new[] { 1, 2 },
        ["DCD"] = new[] { 1, 2, 4, 5 },
        ["DCD2"] = new[] { 1, 2, 7 },
        ["RP"] = new[] { 1, 2, 3 },
        ["RPPD"] = new[] { 1, 2, 3, 4, 5, 6 },
        ["RPPD2"] = new[] { 1, 2, 3, 7 },
        ["PVB"] = new[] { 8, 9 },
        ["SVB"] = new[] { 8, 9 },
    };
    var bypassDeviceSet = new System.Collections.Generic.HashSet<string> { "DCD", "DCD2", "RPPD", "RPPD2" };
    var meterDeviceSet = new System.Collections.Generic.HashSet<string> { "DCD", "DCD2", "RPPD", "RPPD2" };
    var dtoType = typeof(Envirotrax.App.Server.Domain.DataTransferObjects.Backflow.BackflowTestDto);
}
<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
            body {
                font-size: 9.1px;
                font-family: Arial, sans-serif;
            }

            .page-title {
                background-color: #323232;
                color: #ffffff;
                font-size: 10.6px;
                font-weight: bold;
                text-align: center;
                padding: 5px 3px;
                margin-bottom: 5px;
            }

            .section-header {
                background-color: #a0a0a0;
                color: #ffffff;
                font-weight: bold;
                padding: 2.5px 5px;
                margin-top: 5px;
                text-align: center;
                border: 1px solid #323232;
            }

            .label {
                font-weight: bold;
            }

            table {
                width: 100%;
                border-collapse: collapse;
            }

            td {
                border: none;
                padding: 2.5px 5px;
                vertical-align: top;
            }

            th {
                border: 1px solid #323232;
                background-color: #a0a0a0;
                color: #ffffff;
                text-align: center;
                padding: 3px 6px;
                vertical-align: top;
            }

            .readings-table td,
            .readings-table th {
                border: 1px solid #ccc;
                text-align: center;
                padding: 3px 5px;
            }

            .readings-table thead th {
                background-color: #a0a0a0;
                color: #ffffff;
            }

            .readings-table tbody th {
                background-color: #a0a0a0;
                color: #ffffff;
                text-align: left;
                white-space: nowrap;
            }

            .readings-device-label {
                background-color: #e0e0e0 !important;
                color: #323232 !important;
                font-weight: bold;
            }

            .readings-table td {
                text-align: left;
            }

            .disapproval-box {
                border: 2px solid red;
                background: #ffe0e0;
                color: darkred;
                font-weight: bold;
                padding: 6px;
                margin-top: 8px;
            }

            .test-wrapper {
                display: flex;
                flex-direction: column;
            }

            .test-wrapper:not(:last-child) {
                break-after: page;
            }

            .footer-note {
                font-size: 9px;
                font-style: italic;
                text-align: center;
                margin-top: auto;
                margin-bottom: 12px;
                color: #555;
            }
    </style>
</head>

<body>
    @foreach (var test in Model)
    {
        var reasonLabel = reasonLabels.TryGetValue((int)test.ReasonForTest, out var rl) ? rl :
        test.ReasonForTest.ToString();
        var resultLabel = resultLabels.TryGetValue((int)test.TestResult, out var rtl) ? rtl : test.TestResult.ToString();

        // Per-test readings setup
        var isAG = test.DeviceType == "AG";
        int[] colIndices = test.DeviceType != null && deviceColMap.TryGetValue(test.DeviceType, out var mapIdx) ? mapIdx :
        System.Array.Empty<int>();
        var cols = allReadingCols.Where(c => colIndices.Contains(c.Index)).ToArray();
        bool showBypassHdr = test.DeviceType != null && bypassDeviceSet.Contains(test.DeviceType);
        bool showMeterRow = test.DeviceType != null && meterDeviceSet.Contains(test.DeviceType);
        int mainColCnt = cols.Count(c => c.Group == "main");
        int bypassColCnt = cols.Count(c => c.Group == "bypass");
        string deviceLabel = test.DeviceType != null && deviceTypeLabels.TryGetValue(test.DeviceType, out var dlbl) ? dlbl :
        (test.DeviceType ?? "");
        var hasBackflowManufacturer = test.Manufacturer2 != null;
        var gaugeBase = string.Join(" ", new[] { test.GaugeManufacturer, test.GaugeModel }.Where(s =>
    !string.IsNullOrWhiteSpace(s)));
        var gaugeDesc = string.IsNullOrWhiteSpace(gaugeBase) ? "" : gaugeBase + (test.GaugeNonPotable ? " (non-potable)" : " (potable)");

        Func<string?, decimal?> getPSID = f =>
        {
            if (f == null) return null;
            var v = dtoType.GetProperty(f)?.GetValue(test);
            return v == null ? (decimal?)null : (decimal)v;
        };
        Func<string, bool> getBool = f =>
        {
            var v = dtoType.GetProperty(f)?.GetValue(test);
            return v != null && (bool)v;
        };
        Func<string?, string?> getStr = f =>
        {
            if (f == null) return null;
            return dtoType.GetProperty(f)?.GetValue(test) as string;
        };

        <div class="test-wrapper">
            <div class="content">
                <div class="page-title">@test.WaterSupplier?.Name &ndash; Backflow Prevention Assembly Test and Maintenance
                    Report</div>
                    <p style="margin:3px 0; font-size:9.1px; text-align:center;">The following form must be completed for each
                        assembly tested for recordkeeping *purposes:</p>

                        <div class="section-header">Water Supplier</div>
                        <table>
                            <tr>
                                <td class="label" style="width:120px">Water supplier:</td>
                                <td>@test.WaterSupplier?.Name</td>
                                <td class="label" style="width:110px">Contact name:</td>
                                <td>@test.WaterSupplier?.ContactName</td>
                            </tr>
                            <tr>
                                <td class="label">Address:</td>
                                <td>@test.WaterSupplier?.Address</td>
                                <td class="label">Phone number:</td>
                                <td>@test.WaterSupplier?.PhoneNumber</td>
                            </tr>
                            <tr>
                                <td class="label">PWS ID:</td>
                                <td>@test.WaterSupplier?.PwsId</td>
                                <td class="label">Email address:</td>
                                <td colspan="3">@test.WaterSupplier?.EmailAddress</td>
                            </tr>
                        </table>

                        <div class="section-header">BPAT Information</div>
                        <table>
                            <tr>
                                <td class="label" style="width:120px">Company name:</td>
                                <td>@test.BpatCompanyName</td>
                                <td class="label" style="width:110px">Work number:</td>
                                <td>@test.BpatWorkNumber</td>
                            </tr>
                            <tr>
                                <td class="label">Tester name:</td>
                                <td>@test.BpatContactName</td>
                                <td class="label">Cell number:</td>
                                <td>@test.BpatCellNumber</td>
                            </tr>
                            <tr>
                                <td class="label">License number:</td>
                                <td>@test.BpatLicenseNumber</td>
                                <td class="label">Address:</td>
                                <td>@test.BpatAddress @test.BpatCity @test.BpatState?.Name @test.BpatZip</td>
                            </tr>
                            <tr>
                                <td class="label">License expiration:</td>
                                <td>@test.BpatLicenseExpiration?.ToString("MM/dd/yyyy")</td>
                                <td class="label"></td>
                                <td colspan="3"></td>
                            </tr>
                        </table>
                        <table>
                            <tr>
                                <td class="ps-0">
                                    <div class="section-header">Location / Property Information</div>
                                    <table>
                                        <tr>
                                            <td class="label" style="width:120px">Property type:</td>
                                            <td>@(test.PropertyType == 0 ? "Commercial" : "Residential")</td>
                                        </tr>
                                        <tr>
                                            <td class="label">Business name:</td>
                                            <td>@test.PropertyBusinessName</td>
                                        </tr>
                                        <tr>
                                            <td class="label">Property address:</td>
                                            <td>@test.PropertyStreetNumber @test.PropertyStreetName @test.PropertyCity
                                                @test.PropertyState?.Name @test.PropertyZip
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                                <td class="pe-0">
                                    <div class="section-header">Contact / Mailing Information</div>
                                    <table>
                                        <tr>
                                            <td class="label" style="width:120px">Company name:</td>
                                            <td>@test.MailingCompanyName</td>
                                        </tr>
                                        <tr>
                                            <td class="label">Contact name:</td>
                                            <td>@test.MailingContactName</td>
                                        </tr>
                                        <tr>
                                            <td class="label">Mailing address:</td>
                                            <td>@test.MailingStreetNumber @test.MailingStreetName @test.MailingCity
                                                @test.MailingState?.Name @test.MailingZip</td>
                                            </tr>
                                            <tr>
                                                <td class="label">Phone number:</td>
                                                <td>@test.MailingPhoneNumber</td>
                                            </tr>
                                            <tr>
                                                <td class="label">Email address:</td>
                                                <td>@test.MailingEmailAddress</td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <div class="section-header">Backflow Information</div>
                            <div class="mb-2">`
                                <p style="margin:2px 0; font-size:9.1px;">
                                    The backflow prevention assembly detailed below has been tested and maintained as required by
                                    commission
                                    regulations and is certified to be operating within acceptable parameters.
                                </p>
                            </div>
                            <table>
                                <tr>
                                    <td class="label" style="width:120px">Backflow method:</td>
                                    <td colspan="8">@deviceLabel</td>
                                </tr>
                                <tr>
                                    <td class="label" colspan="2">Main Assembly Manufacturer:</td>
                                    <td>@test.Manufacturer</td>
                                    <td class="label">Model:</td>
                                    <td>@test.Model</td>
                                    <td class="label">Size:</td>
                                    <td>@test.Size</td>
                                    <td class="label">Serial number:</td>
                                    <td>@(test.UnknownSerialNumber ? "Unknown" : test.SerialNumber)</td>
                                </tr>

                                @if (hasBackflowManufacturer)
                                {
                                    <tr>
                                        <td class="label" colspan="2">Bypass Assembly Manufacturer:</td>
                                        <td>@test.Manufacturer2</td>
                                        <td class="label">Model:</td>
                                        <td>@test.Model2</td>
                                        <td class="label">Size:</td>
                                        <td>@test.Size2</td>
                                        <td class="label">Serial number:</td>
                                        <td>@(test.UnknownSerialNumber ? "Unknown" : test.SerialNumber2)</td>
                                    </tr>
                                }

                                <tr>
                                    <td class="label">Location:</td>
                                    <td colspan="8">@test.LocationDescription</td>
                                </tr>
                                <tr>
                                    <td class="label">Hazard type****:</td>
                                    <td colspan="8">@test.HazardType</td>
                                </tr>
                            </table>

                            <div class="section-header">Backflow Test Information</div>
                            <table>
                                <tr>
                                    <td class="label" style="width:120px">Test result:</td>
                                    <td colspan="5">@resultLabel</td>
                                </tr>
                                <tr>
                                    <td class="label">Reason for test:</td>
                                    <td colspan="6">@reasonLabel</td>
                                </tr>
                                <tr>
                                    <td class="label" colspan="5">Is the assembly installed in accordance with manufacturer
                                        recommendations
                                        and/or local codes?</td>
                                        <td colspan="2">@(test.ProperlyInstalled ? "Yes" : "No")</td>
                                    </tr>
                                    <tr>
                                        <td class="label" colspan="5">Is the assembly installed on a non-potable water supply (auxiliary)?
                                        </td>
                                        <td colspan="2">@(test.NonPotable ? "Yes" : "No")</td>
                                    </tr>
                                    <tr>
                                        <td class="label" colspan="2">Differential Pressure Gauge Used:</td>
                                        <td>@gaugeDesc</td>
                                        <td class="label">Serial number:</td>
                                        <td>@test.GaugeSerialNumber</td>
                                        <td class="label">Date Tested for Accuracy:</td>
                                        <td>@test.GaugeLastCalibrationDate?.ToString("MM/dd/yyyy")</td>
                                    </tr>
                                </table>

                                @if (isAG)
                                {
                                    <div class="section-header">Air Gap Test Information</div>
                                    <table class="readings-table mt-1">
                                        <tbody>
                                            <tr>
                                                <td>
                                                    Do you certify that the air gap between the potable water supply and the overflow rim
                                                    of the containment vessel complies with the requirements of an approved air gap and has
                                                    not been bypassed, or otherwise made ineffective?
                                                </td>
                                                <td style="white-space:nowrap">@(test.AirGapValid ? "✓ Yes" : "☐ No")</td>
                                            </tr>
                                            <tr>
                                                <td colspan="2"><span class="label">Test Date:</span> @test.TestDate?.ToString("MM/dd/yyyy")
                                                </td>
                                            </tr>
                                            <tr>
                                                <td colspan="2">(An approved air gap shall be at least twice the diameter of the supply pipe
                                                    measured vertically above the overflow rim of the receiving vessel, and in no case less than
                                                    1
                                                    inch.)
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                }
                                else if (cols.Length > 0)
                                {
                                    <table class="readings-table mt-2">
                                        <thead>
                                            <tr>
                                                <th style="min-width:90px; background-color:transparent; border:none;"></th>
                                                <th colspan="@cols.Length" class="readings-device-label">@deviceLabel</th>
                                            </tr>
                                            @if (showBypassHdr)
                                            {
                                                <tr>
                                                    <th style="background-color:transparent; border:none;"></th>
                                                    <th colspan="@mainColCnt">Main Assembly</th>
                                                    <th colspan="@bypassColCnt">Bypass Assembly</th>
                                                </tr>
                                            }
                                            <tr>
                                                <th style="background-color:transparent; border:none;"></th>
                                                @foreach (var col in cols)
                                                {
                                                    <th>@col.Header</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <th>
                                                    <div style="font-weight:bold;text-align:center;margin-bottom:3px">Initial Test</div>
                                                    @if (test.InitialTestDate.HasValue)
                                                    {
                                                        <div><strong>Date:</strong> @test.InitialTestDate?.ToString("MM/dd/yyyy")</div>
                                                    }
                                                </th>
                                                @foreach (var col in cols)
                                                {
                                                    var psid0 = getPSID(col.InitVal);
                                                    <td>
                                                        @if (psid0.HasValue)
                                                        {
                                                            <div>@col.InitVerb @psid0 PSID</div>
                                                        }
                                                        @foreach (var chk in col.InitChecks)
                                                        {
                                                            <div>@(getBool(chk.Field) ? "✓" : "☐") @chk.Label</div>
                                                        }
                                                    </td>
                                                }
                                            </tr>
                                            <tr>
                                                <th>Repairs and Materials Used</th>
                                                @foreach (var col in cols)
                                                {
                                                    <td>@getStr(col.RepairField)</td>
                                                }
                                            </tr>
                                            <tr>
                                                <th>Repair Details</th>
                                                @foreach (var col in cols)
                                                {
                                                    <td>@getStr(col.RepairDetailsField)</td>
                                                }
                                            </tr>
                                            <tr>
                                                <th>
                                                    <div style="font-weight:bold;text-align:center;margin-bottom:3px">Test After Repairs</div>
                                                    @if (test.RepairTestDate.HasValue)
                                                    {
                                                        <div><strong>Date:</strong> @test.RepairTestDate?.ToString("MM/dd/yyyy")</div>
                                                    }
                                                </th>
                                                @foreach (var col in cols)
                                                {
                                                    var psid1 = getPSID(col.FinalVal);
                                                    <td>
                                                        @if (psid1.HasValue)
                                                        {
                                                            <div>@col.FinalVerb @psid1 PSID</div>
                                                        }
                                                        @foreach (var chk in col.FinalChecks)
                                                        {
                                                            <div>@(getBool(chk.Field) ? "✓" : "☐") @chk.Label</div>
                                                        }
                                                    </td>
                                                }
                                            </tr>
                                            @if (showMeterRow)
                                            {
                                                <tr>
                                                    <th>Bypass Meter Test</th>
                                                    <td colspan="@cols.Length">
                                                        <div>Meter #: @test.MeterNumber</div>
                                                        <div>Reading before: @test.MeterReadingBefore</div>
                                                        <div>Registers flow: @(test.MeterRegisters ? "Yes" : "No")</div>
                                                        <div>Reading after: @test.MeterReadingAfter</div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }

                                <div class="section-header">Additional Information Required by @test.WaterSupplier?.Name ****</div>
                                <table>
                                    <tr>
                                        <td class="label" style="width:120px">Water Meter Number:</td>
                                        <td>@test.MeterNumber</td>
                                    </tr>
                                    <tr>
                                        <td class="label" style="width:120px">Permit Number:</td>
                                        <td>@test.PermitNumber</td>
                                    </tr>
                                </table>

                                <div class="section-header">Remarks</div>
                                <table>
                                    <tr>
                                        <td style="min-height:60px">@test.Comments</td>
                                    </tr>
                                </table>

                                @if (test.Disapproved)
                                {
                                    <div class="disapproval-box">DISAPPROVED</div>
                                }
                            </div>

                            <div class="footer-note">
                                The above is certified to be true at the time of testing.<br>
                                * TEST RECORDS MUST BE KEPT FOR AT LEAST THREE YEARS [30 TAC 290.46(B)]<br>
                                ** USE ONLY MANUFACTURER'S REPLACEMENT PARTS<br>
                                *** 2nd Check: Numeric reading required for double check valve only.<br>
                                **** Indicates additional information not present on the standard TCEQ report<br>
                            </div>
                        </div>
                    }
                </body>

            </html>
