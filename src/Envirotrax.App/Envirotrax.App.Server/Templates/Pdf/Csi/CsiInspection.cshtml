@model System.Collections.Generic.IEnumerable<Envirotrax.App.Server.Domain.DataTransferObjects.Csi.CsiInspectionPdfModel>
@{
    Layout = null;
    var reasonLabels = new[] {
        "New construction",
        "Existing service where contaminant hazards are suspected",
        "Major renovation or expansion of distribution facilities"
    };
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        body {
            font-size: 9.1px;
            font-family: Arial, sans-serif;
        }

        .page-title {
            background-color: #323232;
            color: #ffffff;
            font-size: 10.6px;
            font-weight: bold;
            text-align: center;
            padding: 5px 3px;
            margin-bottom: 5px;
        }

        .section-header {
            background-color: #a0a0a0;
            color: #ffffff;
            font-weight: bold;
            padding: 2.5px 5px;
            margin-top: 5px;
            text-align: center;
            border: 1px solid #323232;
        }

        .label {
            font-weight: bold;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        td {
            border: none;
            padding: 2.5px 5px;
            vertical-align: top;
        }

        th {
            border: 1px solid #323232;
            background-color: #a0a0a0;
            color: #ffffff;
            text-align: center;
            padding: 3px 6px;
            vertical-align: top;
        }

        .compliance-check {
            text-align: center;
            font-size: 14px;
        }

        .disapproval-box {
            border: 2px solid red;
            background: #ffe0e0;
            color: darkred;
            font-weight: bold;
            padding: 6px;
            margin-top: 8px;
        }

        .footer-note {
            font-size: 9px;
            font-style: italic;
            text-align: center;
            margin-top: 16px;
            color: #555;
        }

        .pdf-page {
            break-after: page;
        }

        .pdf-page:last-child {
            break-after: auto;
        }

        .assembly-table {
            margin-top: 5px;
        }

        .assembly-table th {
            background-color: #f0f0f0;
            color: #000000;
            border: 1px solid #505050;
        }

        .assembly-table td {
            border: 1px solid #c8c8c8;
            padding: 3.5px 8px;
        }

        .assembly-table tr {
            break-inside: avoid;
        }

        .assembly-table tbody tr:nth-child(even) td {
            background-color: #e6e6f0;
        }

        .date-label {
            display: inline-block;
            width: 52px;
        }

        .additional-info {
            margin: 14px 0 0 35%;
        }

        .additional-info-group {
            margin-bottom: 10px;
        }

        .additional-info-row {
            padding: 1.5px 0;
        }

        .checkbox {
            display: inline-block;
            width: 9px;
            height: 9px;
            line-height: 9px;
            margin-right: 7px;
            border: 1px solid #323232;
            text-align: center;
            font-size: 9px;
            vertical-align: -1px;
        }
    </style>
</head>
<body>
@foreach (var item in Model)
{
    var inspection = item.Inspection;
    var reasonLabel = (int)inspection.ReasonForInspection < reasonLabels.Length
        ? reasonLabels[(int)inspection.ReasonForInspection] : "";
    var propertyAddress = $"{inspection.PropertyStreetNumber} {inspection.PropertyStreetName}"
        + (string.IsNullOrWhiteSpace(inspection.PropertyNumber) ? "" : $" #{inspection.PropertyNumber}");

    <div class="pdf-page">
        <div class="page-title">@inspection.WaterSupplier?.Name &ndash; Customer Service Inspection</div>

        <div class="section-header">Water Supplier</div>
        <table>
            <tr>
                <td class="label" style="width:120px">Water supplier:</td>
                <td>@inspection.WaterSupplier?.Name</td>
                <td class="label" style="width:110px">Contact name:</td>
                <td>@inspection.WaterSupplier?.ContactName</td>
            </tr>
            <tr>
                <td class="label" style="width:120px">Address:</td>
                <td>@inspection.WaterSupplier?.Address</td>
                <td class="label">Phone number:</td>
                <td>@inspection.WaterSupplier?.PhoneNumber</td>
            </tr>
            <tr>
                <td class="label">PWS ID:</td>
                <td>@inspection.WaterSupplier?.PwsId</td>
                <td class="label">Email address:</td>
                <td colspan="3">@inspection.WaterSupplier?.EmailAddress</td>
            </tr>
        </table>

        <div class="section-header">CSI Inspector</div>
        <table>
            <tr>
                <td class="label" style="width:120px">Company name:</td>
                <td>@inspection.InspectorCompanyName</td>
                <td class="label" style="width:110px">Phone number:</td>
                <td>@inspection.InspectorWorkNumber</td>
            </tr>
            <tr>
                <td class="label">Title of inspector:</td>
                <td>@inspection.InspectorJobTitle</td>
                <td class="label">Email address:</td>
                <td>@inspection.Id</td>
            </tr>
            <tr>
                <td class="label">Inspector name:</td>
                <td>@inspection.InspectorContactName</td>
                <td class="label">License number:</td>
                <td>@inspection.InspectorLicenseNumber</td>
            </tr>
            <tr>
                <td class="label">Address:</td>
                <td>@inspection.InspectorAddress, @inspection.InspectorCity @inspection.InspectorState @inspection.InspectorZip</td>
                <td class="label">License type:</td>
                <td>@inspection.InspectorLicenseType</td>
            </tr>
        </table>
        <table>
            <tr>
                <td class="ps-0">
                    <div class="section-header">Location / Property Information</div>
                    <table>
                        <tr>
                            <td class="label" style="width:120px">Property type:</td>
                            <td>@(inspection.PropertyType == Envirotrax.App.Server.Data.Models.Sites.PropertyType.Commercial ? "Commercial" : "Residential")</td>
                        </tr>
                        <tr>
                            <td class="label">Business name:</td>
                            <td>@inspection.PropertyBusinessName</td>
                        </tr>
                        <tr>
                            <td class="label">Property address:</td>
                            <td>@inspection.PropertyStreetNumber @inspection.PropertyStreetName, @inspection.PropertyCity @inspection.PropertyState?.Name @inspection.PropertyZip</td>
                        </tr>
                    </table>
                </td>
                <td class="pe-0">
                    <div class="section-header">Contact / Mailing Information</div>
                    <table>
                        <tr>
                            <td class="label" style="width:120px">Company name:</td>
                            <td>@inspection.MailingCompanyName</td>
                        </tr>
                        <tr>
                            <td class="label">Contact name:</td>
                            <td>@inspection.MailingContactName</td>
                        </tr>
                        <tr>
                            <td class="label">Mailing address:</td>
                            <td colspan="3">@inspection.MailingStreetNumber @inspection.MailingStreetName, @inspection.MailingCity @inspection.MailingState?.Name @inspection.MailingZip</td>
                        </tr>
                        <tr>
                            <td class="label" style="width:110px">Phone number:</td>
                            <td>@inspection.MailingPhoneNumber</td>
                        </tr>
                        <tr>
                            <td class="label">Email:</td>
                            <td>@inspection.MailingEmailAddress</td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>

        <div class="section-header">Inspection Results</div>
        <table>
            <tr>
                <td><span class="label">Reason for inspection:</span> @reasonLabel</td>
                <td style="width:160px"><span class="label">Inspection date:</span> @inspection.InspectionDate?.ToString("MM/dd/yyyy")</td>
            </tr>
        </table>

        <div class="p-2 mb-2 border border-3 border-secondary-subtle">
            <p style="margin:3px 0; font-size:9.1px;">
                I, <u>@inspection.InspectorContactName</u>, upon inspection of the private water distribution facilities
                connected to the aforementioned public water supply do hereby certify that, to the best of my knowledge:
            </p>
            <table>
                <tr>
                    <td></td>
                    <td></td>
                    <td style="width:80px">Compliance</td>
                    <td style="width:100px">Non-compliance</td>
                </tr>
                @{
                    var statements = new[] {
                        "No direct or indirect connection between the public drinking water supply and a potential source of contamination exists.",
                        "No cross-connection between the public drinking water supply and a private water system exists.",
                        "No connection exists which would allow the return of water used for condensing, cooling or industrial processes back to the public water supply.",
                        "No pipe or pipe fitting which contains more than 8.0% lead exists in private water distribution facilities installed on or after July 1, 1988 and prior to January 4, 2014.",
                        "Plumbing installed on or after January 4, 2014 bears the expected labeling indicating ≤0.25% lead content.",
                        "No solder or flux which contains more than 0.2% lead exists in private water distribution facilities installed on or after July 1, 1988."
                    };
                    var compliances = new bool[] {
                        inspection.Compliance1, inspection.Compliance2, inspection.Compliance3,
                        inspection.Compliance4, inspection.Compliance5, inspection.Compliance6
                    };
                }
                @for (var i = 0; i < 6; i++)
                {
                    <tr>
                        <td>@(i + 1).</td>
                        <td>@statements[i]</td>
                        <td class="compliance-check">@(compliances[i] ? "✓" : "○")</td>
                        <td class="compliance-check">@(!compliances[i] ? "✓" : "○")</td>
                    </tr>
                }
            </table>
        </div>

        <div class="p-2 mb-2 border border-3 border-secondary-subtle">
            <p style="margin:3px 0; font-size:9.1px;">
                I further certify that the following materials were used in the installation of the private water distribution facilities:
            </p>
            <table>
                <tr>
                    <td class="label" style="width:100px">Service lines:</td>
                    <td>@(inspection.MaterialServiceLineLead ? "✓" : "□") Lead</td>
                    <td>@(inspection.MaterialServiceLineCopper ? "✓" : "□") Copper</td>
                    <td>@(inspection.MaterialServiceLinePVC ? "✓" : "□") PVC</td>
                    <td>@(inspection.MaterialServiceLineOther ? $"✓ Other: {inspection.MaterialServiceLineOtherDescription}" : "□ Other")</td>
                </tr>
                <tr>
                    <td class="label">Solder:</td>
                    <td>@(inspection.MaterialSolderLead ? "✓" : "□") Lead</td>
                    <td>@(inspection.MaterialSolderLeadFree ? "✓" : "□") Lead free</td>
                    <td>@(inspection.MaterialSolderSolventWeld ? "✓" : "□") Solvent weld</td>
                    <td>@(inspection.MaterialSolderOther ? $"✓ Other: {inspection.MaterialSolderOtherDescription}" : "□ Other")</td>
                </tr>
            </table>
        </div>

        <div class="p-2 mb-2 border border-3 border-secondary-subtle">
            <p style="margin:3px 0; font-size:9.1px;">
                ✓ I recognize that this document shall be retained by the aforementioned Public Water System for a minimum of ten years and that I am legally
                responsible for the validity of the information I have provided.
            </p>
        </div>

        <div class="section-header">Remarks</div>
        <table>
            <tr>
                <td style="min-height:60px">@inspection.Comments</td>
            </tr>
        </table>

        @if (inspection.Disapproved)
        {
            <div class="disapproval-box">DISAPPROVED &mdash; @inspection.DisapprovedReason</div>
        }

        <div class="footer-note">
            A Customer Service Inspection Certificate should be on file for each connection in a public water system
            to document compliance with 30 TAC &sect;290.44(h)/290.46(j).
        </div>
    </div>

    if (item.Assemblies.Count > 0)
    {
        <div class="pdf-page">
            <div class="section-header">Assemblies at this Location - @propertyAddress</div>
            <table class="assembly-table">
                <thead>
                    <tr>
                        <th style="width:33%">Assembly Information</th>
                        <th style="width:40%">Location Description</th>
                        <th style="width:27%">Expiration Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var assembly in item.Assemblies)
                    {
                        <tr>
                            <td>
                                <div>@assembly.AssemblyDescription</div>
                                <div>SN: @assembly.SerialNumber</div>
                            </td>
                            <td>
                                <div>@assembly.LocationDescription</div>
                                @if (assembly.HazardType == "Fire System")
                                {
                                    <div>*** Fire System ***</div>
                                }
                            </td>
                            <td>
                                <div><span class="date-label">Tested On:</span> @assembly.TestDate?.ToString("M/d/yyyy")</div>
                                <div><span class="date-label">Expiration:</span> @assembly.ExpirationDate?.ToString("M/d/yyyy")</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    var additionalInformationGroups = new[]
    {
        new[] { ("Has On Site Sewage Facility", inspection.AiOssf), ("Has Auxiliary Water Supply", inspection.AiWaterWell), ("Has Reclaimed Water", inspection.AiReclaimedWater) },
        new[] { ("Has Fire System", inspection.AiFireSystem), ("Fire System on Separate Water Supply", inspection.AiFireSystem2) },
        new[] { ("Has Grease Trap", inspection.AiGreaseTrap), ("Has Sand & Grit Trap", inspection.AiSandGrit) },
        new[] { ("Has Irrigation System", inspection.AiIrrigationSystem), ("Irrigation on Separate Water Supply", inspection.AiIrrigationSystem2) },
        new[] { ("Has Domestic/Premises Isolation", inspection.AiHasDomesticPremisesIsolation), ("Requires Domestic/Premises Isolation", inspection.AiRequiresDomesticPremisesIsolation) }
    };

    <div class="pdf-page">
        <div class="section-header">Additional Information - @propertyAddress</div>
        <div class="additional-info">
            @foreach (var group in additionalInformationGroups)
            {
                <div class="additional-info-group">
                    @foreach (var (label, isChecked) in group)
                    {
                        <div class="additional-info-row"><span class="checkbox">@(isChecked ? "✓" : "")</span>@label</div>
                    }
                </div>
            }
        </div>
    </div>
}
</body>
</html>
