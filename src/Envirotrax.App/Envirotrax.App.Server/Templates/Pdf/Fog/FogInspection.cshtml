@model System.Collections.Generic.IEnumerable<Envirotrax.App.Server.Domain.DataTransferObjects.Fog.FogInspectionDto>
@{
    Layout = null;
    var reasonLabels = new[] { "Scheduled", "Unscheduled", "Complaint" };
    var facilityTypeLabels = new[] {
        "Other", "Restaurant", "Fast Food Establishment", "Hotel/Motel", "Car Wash",
        "School/University", "Grocery Store", "Convenience Store", "Assisted Living Facility",
        "Medical Facility", "Industrial", "City Owned Facility"
    };
    Func<string?, string?, string> getPercent = (num, denom) =>
    {
        if (!double.TryParse(num, out var n) || !double.TryParse(denom, out var d) || d == 0)
        {
            return "";
        }
        return Math.Round(n / d * 100) + "%";
    };
    Func<bool?, string> yesNo = value =>
    {
        var yes = value == true ? "●" : "○";
        var no = value == false ? "●" : "○";
        return $"{yes} Yes   {no} No";
    };
    Func<bool, string> passedFailed = passed =>
    {
        var p = passed ? "●" : "○";
        var f = !passed ? "●" : "○";
        return $"{p} Passed   {f} Failed";
    };
}
<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
            body {
                font-size: 9.1px;
                font-family: Arial, sans-serif;
            }

            .page-title {
                background-color: #323232;
                color: #ffffff;
                font-size: 10.6px;
                font-weight: bold;
                text-align: center;
                padding: 5px 3px;
                margin-bottom: 5px;
            }

            .section-header {
                background-color: #a0a0a0;
                color: #ffffff;
                font-weight: bold;
                padding: 2.5px 5px;
                margin-top: 5px;
                text-align: center;
                border: 1px solid #323232;
            }

            .subsection-label {
                font-weight: bold;
                margin-top: 6px;
            }

            .label {
                font-weight: bold;
            }

            table {
                width: 100%;
                border-collapse: collapse;
            }

            td {
                border: none;
                padding: 2.5px 5px;
                vertical-align: top;
            }

            .footer-note {
                font-size: 9px;
                font-style: italic;
                text-align: center;
                margin-top: 16px;
                color: #555;
            }

            .inspection-wrapper:not(:last-child) {
                break-after: page;
            }
    </style>
</head>

<body>
    @foreach (var inspection in Model)
    {
        var reasonLabel = (int)inspection.ReasonForInspection < reasonLabels.Length
            ? reasonLabels[(int)inspection.ReasonForInspection] : "";
        var facilityTypeLabel = (int)inspection.FacilityType < facilityTypeLabels.Length
            ? facilityTypeLabels[(int)inspection.FacilityType] : "";

        <div class="inspection-wrapper">
            <div class="page-title">@inspection.WaterSupplier?.Name &ndash; FOG Inspection</div>

            <table>
                <tr>
                    <td class="ps-0" style="width:50%">
                        @inspection.WaterSupplier?.Name<br />
                        @inspection.WaterSupplier?.Address<br />
                        @inspection.WaterSupplier?.City, @inspection.WaterSupplier?.State?.Name
                        @inspection.WaterSupplier?.ZipCode
                    </td>
                    <td class="pe-0">
                        <span class="label">PWS ID:</span> @inspection.WaterSupplier?.PwsId<br />
                        <span class="label">Phone Number:</span> @inspection.WaterSupplier?.PhoneNumber<br />
                        <span class="label">Email Address:</span> @inspection.WaterSupplier?.EmailAddress
                    </td>
                </tr>
            </table>

            <div class="section-header">Inspector Information</div>
            <table>
                <tr>
                    <td class="label" style="width:130px">Company Name:</td>
                    <td>@inspection.InspectorCompanyName</td>
                    <td class="label" style="width:130px">Phone Number:</td>
                    <td>@inspection.InspectorWorkNumber</td>
                </tr>
                <tr>
                    <td class="label">Title of Inspector:</td>
                    <td>@inspection.InspectorJobTitle</td>
                    <td class="label">Email Address:</td>
                    <td></td>
                </tr>
                <tr>
                    <td class="label">Inspector Name:</td>
                    <td>@inspection.InspectorContactName</td>
                    <td></td>
                    <td></td>
                </tr>
                <tr>
                    <td class="label">Address:</td>
                    <td colspan="3">
                        @inspection.InspectorAddress<br />
                        @inspection.InspectorCity, @inspection.InspectorState @inspection.InspectorZip
                    </td>
                </tr>
            </table>

            <table>
                <tr>
                    <td class="ps-0" style="width:50%">
                        <div class="section-header">Location Information</div>
                        <table>
                            <tr>
                                <td class="label" style="width:120px">Property Type:</td>
                                <td>@(inspection.PropertyType ==
                                                                                                                                                                                Envirotrax.App.Server.Data.Models.Sites.PropertyType.Commercial ? "Commercial" :
                                                                                                                                                                    "Residential")</td>
                                </tr>
                                <tr>
                                    <td class="label">Business Name:</td>
                                    <td>@inspection.PropertyBusinessName</td>
                                </tr>
                                <tr>
                                    <td class="label">Property Address:</td>
                                    <td>
                                        @inspection.PropertyStreetNumber @inspection.PropertyStreetName<br />
                                        @inspection.PropertyCity, @inspection.PropertyState?.Code @inspection.PropertyZip
                                    </td>
                                </tr>
                            </table>
                        </td>
                        <td class="pe-0">
                            <div class="section-header">Contact Information</div>
                            <table>
                                <tr>
                                    <td class="label" style="width:120px">Company Name:</td>
                                    <td>@inspection.MailingCompanyName</td>
                                </tr>
                                <tr>
                                    <td class="label">Contact Name:</td>
                                    <td>@inspection.MailingContactName</td>
                                </tr>
                                <tr>
                                    <td class="label">Mailing Address:</td>
                                    <td>
                                        @inspection.MailingStreetNumber @inspection.MailingStreetName<br />
                                        @inspection.MailingCity, @inspection.MailingState?.Code @inspection.MailingZip
                                    </td>
                                </tr>
                                <tr>
                                    <td class="label">Phone Number:</td>
                                    <td>@inspection.MailingPhoneNumber</td>
                                </tr>
                                <tr>
                                    <td class="label">Email Address:</td>
                                    <td>@inspection.MailingEmailAddress</td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>

                <div class="section-header">Interceptor Information</div>
                <table>
                    <tr>
                        <td class="label" style="width:180px">This Waste was Removed From:</td>
                        <td>@inspection.InterceptorType @inspection.InterceptorOtherDescription</td>
                    </tr>
                    <tr>
                        <td class="label">Waste Trap or Tank Capacity:</td>
                        <td>@inspection.InterceptorCapacity Gallons</td>
                    </tr>
                    <tr>
                        <td class="label">Location Description:</td>
                        <td>@inspection.InterceptorLocationDescription</td>
                    </tr>
                </table>

                <div class="section-header">Inspection Results</div>
                <table>
                    <tr>
                        <td class="label" style="width:180px">Inspection Date:</td>
                        <td colspan="3">@inspection.InspectionDate?.ToString("dd.MM.yyyy H:mm")</td>
                    </tr>
                    <tr>
                        <td class="label">Reason for Inspection:</td>
                        <td>@reasonLabel</td>
                        <td class="label" style="width:130px">Facility Type:</td>
                        <td>@facilityTypeLabel</td>
                    </tr>
                </table>

                <table>
                    <tr>
                        <td class="ps-0" style="width:50%">
                            <table>
                                <tr>
                                    <td style="width:220px">Is it properly maintained?</td>
                                    <td>@yesNo(inspection.Maintained)</td>
                                </tr>
                                <tr>
                                    <td>Is it accessible?</td>
                                    <td>@yesNo(inspection.Accessible)</td>
                                </tr>
                                <tr>
                                    <td>Is there evidence of past overflow?</td>
                                    <td>@yesNo(inspection.PastOverflow)</td>
                                </tr>
                            </table>
                        </td>
                        <td class="pe-0">
                            <div class="subsection-label">Sampling Point:</div>
                            <table>
                                <tr>
                                    <td style="width:200px">Is it accessible?</td>
                                    <td>@yesNo(inspection.SamplingPointAccessible)</td>
                                </tr>
                                <tr>
                                    <td>Does it need to be cleaned?</td>
                                    <td>@yesNo(inspection.SamplingPointClean)</td>
                                </tr>
                                <tr>
                                    <td>Sampled From:</td>
                                    <td>@inspection.SampledFrom</td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>

                <table>
                    <tr>
                        <td class="ps-0" style="width:50%">
                            <div class="subsection-label">Inlet Chamber:</div>
                            <table>
                                <tr>
                                    <td style="width:220px">Is the inlet tee visible?</td>
                                    <td>@yesNo(inspection.InletTeeVisible)</td>
                                </tr>
                                <tr>
                                    <td>Is the inlet tee intact?</td>
                                    <td>@yesNo(inspection.InletTeeIntact)</td>
                                </tr>
                                <tr>
                                    <td>&nbsp;</td>
                                    <td></td>
                                </tr>
                                <tr>
                                    <td>Wetted Height in Inches:</td>
                                    <td>@inspection.InletChamberWettingHeight</td>
                                </tr>
                                <tr>
                                    <td>Grease Blanket in Inches:</td>
                                    <td>@inspection.InletChamberGreaseBlanket</td>
                                </tr>
                                <tr>
                                    <td>Sediments in Inches:</td>
                                    <td>@inspection.InletChamberSediments</td>
                                </tr>
                                <tr>
                                    <td>&nbsp;</td>
                                    <td></td>
                                </tr>
                                <tr>
                                    <td>Grease Layer %:</td>
                                    <td>@getPercent(inspection.InletChamberGreaseBlanket, inspection.InletChamberWettingHeight)
                                    </td>
                                </tr>
                                <tr>
                                    <td>Sediment Layer %:</td>
                                    <td>@getPercent(inspection.InletChamberSediments, inspection.InletChamberWettingHeight)</td>
                                </tr>
                                <tr>
                                    <td class="label">Total Inlet Chamber %:</td>
                                    <td>@inspection.InletTotalCapacityPercent%</td>
                                </tr>
                            </table>
                        </td>
                        <td class="pe-0">
                            <div class="subsection-label">Outlet Chamber:</div>
                            <table>
                                <tr>
                                    <td style="width:220px">Is the outfall tee visible?</td>
                                    <td>@yesNo(inspection.OutletTeeVisible)</td>
                                </tr>
                                <tr>
                                    <td>Is the outfall tee intact?</td>
                                    <td>@yesNo(inspection.OutletTeeIntact)</td>
                                </tr>
                                <tr>
                                    <td>&nbsp;</td>
                                    <td></td>
                                </tr>
                                <tr>
                                    <td>Wetted Height in Inches:</td>
                                    <td>@inspection.OutletChamberWettingHeight</td>
                                </tr>
                                <tr>
                                    <td>Grease Blanket in Inches:</td>
                                    <td>@inspection.OutletChamberGreaseBlanket</td>
                                </tr>
                                <tr>
                                    <td>Sediments in Inches:</td>
                                    <td>@inspection.OutletChamberSediments</td>
                                </tr>
                                <tr>
                                    <td>&nbsp;</td>
                                    <td></td>
                                </tr>
                                <tr>
                                    <td>Grease Layer %:</td>
                                    <td>@getPercent(inspection.OutletChamberGreaseBlanket,
                                                                                                                                                                                                inspection.OutletChamberWettingHeight)</td>
                                    </tr>
                                    <tr>
                                        <td>Sediment Layer %:</td>
                                        <td>@getPercent(inspection.OutletChamberSediments, inspection.OutletChamberWettingHeight)
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Total Outlet Chamber %:</td>
                                        <td>@inspection.OutletTotalCapacityPercent%</td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <table>
                        <tr>
                            <td>&nbsp;</td>
                        </tr>
                        <tr>
                            <td class="label" style="width:220px">Total Capacity %:</td>
                            <td>@inspection.TotalCapacityPercent%</td>
                        </tr>
                        <tr>
                            <td class="label">Inspection Result:</td>
                            <td>@passedFailed(inspection.InspectionResult ==
                                                                                                                                                    Envirotrax.App.Server.Data.Models.Fog.FogInspectionResult.Passed)</td>
                            </tr>
                        </table>

                        <div class="section-header">Remarks</div>
                        <table>
                            <tr>
                                <td style="min-height:60px">@inspection.Comments</td>
                            </tr>
                        </table>
                    </div>
                }
            </body>

        </html>
