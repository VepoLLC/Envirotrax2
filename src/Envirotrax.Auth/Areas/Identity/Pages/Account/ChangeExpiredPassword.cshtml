@page
@model ChangeExpiredPasswordModel
@{
    ViewData["Title"] = "Password Expired";
}

<section id="divPageTitle" class="container-lg page-title">
    <div class="text-center">
        <h1 class="h2">@ViewData["Title"]</h1>
    </div>
</section>

<section id="sectionChangeExpiredPassword" class="card shadow-sm">
    <div class="card-header border-bottom-0 text-center text-white bg-info fw-semibold fs-5 rounded-top">
        <h2 class="h5 mb-0">Create a New Password</h2>
    </div>
    <div class="card-body border border-info rounded-bottom">
        <div class="w-100 mb-3">
            Your password has expired. Please create a new password for your security. To keep our system secure, we may
            ask you from time to time to change your password. We apologize for the inconvenience.
        </div>
        <form id="change-expired-password-form" method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-3" role="alert"></div>

            <div class="row justify-content-center mt-4">
                <div class="col-sm-12 col-md-6 col-lg-5 col-xl-4">

                    <div class="mb-3">
                        <label asp-for="Input.NewPassword" class="form-label fw-bold"></label>
                        <input asp-for="Input.NewPassword"
                               class="form-control"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="Please enter your new password." />
                        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.ConfirmPassword" class="form-label fw-bold"></label>
                        <input asp-for="Input.ConfirmPassword"
                               class="form-control"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="Please confirm your new password." />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="mt-4 text-center">
                        <button type="submit" id="btnChangeExpiredPassword" class="btn btn-primary px-5">
                            Update Password
                        </button>
                    </div>

                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
