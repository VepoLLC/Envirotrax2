@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Confirm email";
}

<div class="d-flex align-items-center justify-content-center">
    <div class="card shadow-sm vp-login-form">
        <div class="card-header text-center text-white bg-info fw-semibold fs-5 rounded-top">
            <h1 class="h4 mb-0">@ViewData["Title"]</h1>
        </div>
        <div class="card-body border border-info rounded-bottom">
            <partial name="_StatusMessage" model="Model.StatusMessage" />

            @if (Model.Succeeded)
            {
                <p>
                    Click on the Login button below to enter your new account.
                </p>

                <div class="d-flex justify-content-center mt-4">
                    <a asp-page="./Login" class="btn btn-primary px-5">
                        <i class="fa-solid fa-right-to-bracket me-2"></i>
                        Login
                    </a>
                </div>
            }
            else
            {
                <p>
                    Your confirmation link may have expired or already been used. Request a new one below.
                </p>

                <div class="d-flex justify-content-center mt-4">
                    <a asp-page="./ResendEmailConfirmation" class="btn btn-primary px-5">
                        Resend Email Confirmation
                    </a>
                </div>
            }
        </div>
    </div>
</div>
