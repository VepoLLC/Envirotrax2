@page
@model EmailModel
@{
    ViewData["Title"] = "Manage Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<partial name="_StatusMessage" for="StatusMessage" />

<form id="email-form" method="post">
    <div asp-validation-summary="All" class="text-danger text-center mb-3" role="alert"></div>

    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">

            @if (Model.IsEmailConfirmed)
            {
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-bold"></label>
                    <div class="input-group">
                        <input asp-for="Email"
                               class="form-control"
                               placeholder="Please enter your email."
                               disabled />
                        <span class="input-group-text text-success fw-bold">&#x2713;</span>
                    </div>
                </div>
            }
            else
            {
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-bold"></label>
                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Please enter your email."
                           disabled />
                    <div class="mt-2">
                        <button id="email-verification"
                                type="submit"
                                asp-page-handler="SendVerificationEmail"
                                class="btn sm">
                            Send verification email
                        </button>
                    </div>
                </div>
            }

            <div class="mb-3">
                <label asp-for="Input.NewEmail" class="form-label fw-bold"></label>
                <input asp-for="Input.NewEmail"
                       class="form-control"
                       autocomplete="email"
                       aria-required="true"
                       placeholder="Please enter new email." />
                <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
            </div>

            <div class="mt-4 text-center">
                <button id="change-email-button"
                        type="submit"
                        asp-page-handler="ChangeEmail"
                        class="btn btn-primary px-5">
                    Change email
                </button>
            </div>

        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
