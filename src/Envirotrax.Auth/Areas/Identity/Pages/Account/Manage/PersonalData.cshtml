@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="w-100 mb-3">
    Your account contains personal data that you have given us. This page allows you to download or delete that data.
</div>

<div class="alert alert-warning" role="alert">
    <strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong>
</div>

<div class="text-center">
    <form id="download-data" asp-page="DownloadPersonalData" method="post" class="d-inline-block me-2">
        <button type="submit" class="btn btn-primary px-5">Download</button>
    </form>

    <a id="delete" asp-page="DeletePersonalData" class="btn link-button red text-decoration-none">Delete</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
