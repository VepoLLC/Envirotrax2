@page
@model VerifyPhoneNumberModel
@{
    ViewData["Title"] = "Verify Phone Number";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="w-100 text-center mb-4">
    We've sent a verification code to @Model.PhoneNumber. Enter it below to confirm this number.
</div>

<form id="verify-phone-form" method="post">
    <input type="hidden" name="phoneNumber" value="@Model.PhoneNumber" />
    <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-3" role="alert"></div>

    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="mb-3">
                <label asp-for="Input.Code" class="form-label fw-bold"></label>
                <input asp-for="Input.Code" class="form-control" autocomplete="off" />
                <span asp-validation-for="Input.Code" class="text-danger"></span>
            </div>

            <div class="mt-4 text-center">
                <button type="submit" class="btn btn-primary px-5">
                    Verify
                </button>
            </div>
        </div>
    </div>
</form>

<form id="resend-code-form" method="post" asp-page-handler="Resend">
    <input type="hidden" name="phoneNumber" value="@Model.PhoneNumber" />
</form>

<div class="mt-3 text-center">
    <a href="javascript:void(0)" onclick="document.getElementById('resend-code-form').submit();">
        Resend code
    </a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
