@page
@model SecuritySuggestionModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="d-flex align-items-center justify-content-center">
    <div class="card shadow-sm vp-login-form">
        <div class="card-header text-center text-white bg-info fw-semibold fs-5 rounded-top">
            <h1 class="h4 mb-0">@ViewData["Title"]</h1>
        </div>
        <div class="card-body border border-info rounded-bottom">
            <p>
                @Model.Message
            </p>

            <div class="d-flex justify-content-center mt-4">
                <a href="@Model.PrimaryActionUrl" class="btn btn-primary px-5">
                    <i class="fa-solid fa-mobile-screen me-2"></i>
                    @Model.PrimaryActionText
                </a>
            </div>

            <div class="d-flex justify-content-center mt-3">
                <a asp-page-handler="Skip" asp-route-returnUrl="@Model.ReturnUrl" class="text-muted small">
                    Skip for now
                </a>
            </div>
        </div>
    </div>
</div>
