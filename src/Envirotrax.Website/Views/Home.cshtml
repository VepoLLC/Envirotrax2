			</div>
			<div class="section">
				<div class="container">
					<div class="row justify-content-center align-items-center gy-3">
						<div class="col-md-6 text-end" data-aos="fade-right" data-aos-delay="100">
							<img src="~/images/home/customer_service4.jpg" class="img-fluid rounded customer-service-photo"
