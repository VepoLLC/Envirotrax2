							<img src="~/images/home/reports.png" class="img-fluid rounded" alt="Envirotrax reports" />
						</div>
					</div>

					<div class="text-center mt-4" data-aos="fade-up" data-aos-delay="100">
						<a href="#" class="texas-link fs-5 fst-italic fw-normal" target="_blank">Trusted statewide to
