						<div class="col-md-6" data-aos="fade-right" data-aos-delay="400">
							<div class="info-box">
								<div class="row align-items-center g-2">
									<div class="col-auto"><i class="fa-solid fa-file-export"></i></div>
									<div class="col">
										<h3>Advanced Data Exporting</h3>
									</div>
								</div>
