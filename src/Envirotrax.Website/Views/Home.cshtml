			</section>

			@if (Model.TestimonalSection != null)
			{
				foreach (var testimonialBlock in Model.TestimonalSection)
				{
					var testimonialSection = testimonialBlock.Content as ContentModels.TestimonialSection;

					if (testimonialSection == null)
					{
						continue;
					}

					var testimonials = testimonialSection.Testimonials?
						.Select(t => t as ContentModels.Testimonial)
						.Where(t => t != null)
						.ToList() ?? new List<ContentModels.Testimonial>();

					if (!testimonials.Any())
					{
						continue;
					}

					<section id="testimonials" class="testimonials section steelblue gradient-left">
						<div class="container">
							<div>
								<h1 class="text-center fw-bold" data-aos="zoom-in" data-aos-delay="100">Testimonials</h1>
								@if (!string.IsNullOrWhiteSpace(testimonialSection.HeaderText))
								{
									<p class="p-2 mb-4">@testimonialSection.HeaderText</p>
								}
							</div>

							@{
								var carouselId = "testimonialsCarousel";
								var count = testimonials.Count;
								var visiblePerSlide = Math.Min(3, count);
							}

							<div id="@carouselId" class="carousel slide" data-bs-ride="carousel" data-bs-interval="5000" data-aos="fade-up"
								 data-aos-delay="100">
								<div class="carousel-inner">
									@for (var start = 0; start < count; start++)
									{
										<div class="carousel-item @(start == 0 ? "active" : "")">
											<div class="row justify-content-center g-4">
												@for (var offset = 0; offset < visiblePerSlide; offset++)
												{
													var testimonial = testimonials[(start + offset) % count];

													<div class="col-md-4 @(offset > 0 ? "testimonial-extra" : "")">
														<div class="testimonial-item">
															<p>
																<i class="bx bxs-quote-alt-left quote-icon-left"></i>
																@testimonial.ShortDescription
																<i class="bx bxs-quote-alt-right quote-icon-right"></i>
															</p>
															<h3>@testimonial.AttesterName</h3>
															@if (!string.IsNullOrWhiteSpace(testimonial.AttesterCompany))
															{
																<h4 class="m-1">@testimonial.AttesterCompany</h4>
															}
															@if (!string.IsNullOrWhiteSpace(testimonial.AttesterCity))
															{
																<h4>@testimonial.AttesterCity</h4>
															}
														</div>
													</div>
												}
											</div>
										</div>
									}
								</div>

								<div class="carousel-buffer"></div>

								@if (count > 1)
								{
									<div class="carousel-indicators">
										@for (var index = 0; index < count; index++)
										{
											<button type="button" data-bs-target="#@carouselId" data-bs-slide-to="@index"
													class="@(index == 0 ? "active" : "")" aria-current="@(index == 0 ? "true" : null)"
													aria-label="Slide @(index + 1)"></button>
										}
									</div>
								}
							</div>
						</div>
					</section>
				}
			}

			<a href="~/request-information/" class="request-info" data-aos="flip-up" data-aos-delay="1000">
				<div class="row g-0">
					<div class="col-auto">
