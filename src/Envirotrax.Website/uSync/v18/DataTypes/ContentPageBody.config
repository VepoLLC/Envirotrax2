  <Info>
    <Name>Content Page Body</Name>
    <EditorAlias>Umbraco.RichText</EditorAlias>
    <EditorUIAlias />
  </Info>
  <Config><![CDATA[{
  "extensions": [
    "Umb.Tiptap.RichTextEssentials",
